<svg xmlns="http://w3.org" viewBox="0 0 512 512" width="512" height="512">
  <defs>
    <!-- 深邃极客黑底板渐变 -->
    <linearGradient id="darkBg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#141821" />
      <stop offset="100%" stop-color="#0B0E14" />
    </linearGradient>

    <!-- 翡翠绿到电光蓝的流动渐变 -->
    <linearGradient id="waveGrad" x1="0%" y1="50%" x2="100%" y2="50%">
      <stop offset="0%" stop-color="#10B981" />
      <stop offset="50%" stop-color="#06B6D4" />
      <stop offset="100%" stop-color="#3B82F6" />
    </linearGradient>

    <!-- 光标竖向渐变 -->
    <linearGradient id="cursorGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#10B981" />
      <stop offset="100%" stop-color="#0EA5E9" />
    </linearGradient>

    <!-- 霓虹微光滤镜 -->
    <filter id="neonGlow" x="-25%" y="-25%" width="150%" height="150%">
      <feGaussianBlur stdDeviation="8" result="blur" />
      <feMerge>
        <feMergeNode in="blur" />
        <feMergeNode in="SourceGraphic" />
      </feMerge>
    </filter>
  </defs>

  <!-- App 圆角矩形底板 -->
  <rect x="24" y="24" width="464" height="464" rx="104" fill="url(#darkBg)" />

  <!-- 组合图形（应用整体霓虹微光） -->
  <g filter="url(#neonGlow)">
    <!-- 正弦波浪平滑过渡到无穷大符号（∞） -->
    <path d="M 88 260
             C 104 205, 128 205, 144 260
             C 160 315, 184 315, 204 260
             C 224 205, 256 205, 280 260
             C 304 315, 348 315, 348 260
             C 348 205, 304 205, 280 260
             C 256 315, 224 315, 204 260"
          fill="none"
          stroke="url(#waveGrad)"
          stroke-width="20"
          stroke-linecap="round"
          stroke-linejoin="round" />

    <!-- 终端命令行方块光标（带呼吸闪烁动画） -->
    <rect x="382" y="206" width="32" height="108" rx="6" fill="url(#cursorGrad)">
      <animate attributeName="opacity" values="1;0.15;1" dur="1.4s" repeatCount="indefinite" />
    </rect>
  </g>
</svg>
